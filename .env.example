# Root for generated tokenizers, datasets, checkpoints, evaluations, and logs.
NANOGPT_HOME=./artifacts

# Hugging Face auth is optional for the public datasets in the default plan.
# Never commit a real token.
HF_TOKEN=

# Required for cloud cost projection and paid training. Set this to the exact
# provider price displayed immediately before instance launch.
NANOGPT_HOURLY_RATE_USD=

# The total project cap. Individual stage caps are also encoded in cloud_100.yaml.
NANOGPT_TOTAL_BUDGET_USD=100

# Optional persistent volume root used by a cloud provider.
NANOGPT_PERSISTENT_ROOT=

# Increase only when debugging distributed launch behavior.
TORCH_DISTRIBUTED_DEBUG=OFF
