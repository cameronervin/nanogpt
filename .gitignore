# Python
__pycache__/
*.py[cod]
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
dist/
build/
*.egg-info/

# Editors and operating systems
.DS_Store
.idea/
.vscode/
*.swp

# Secrets and local overrides
.env
.env.*
!.env.example
*.local.yaml

# Runtime data ($NANOGPT_HOME, default ./artifacts) is never committed,
# plus a safety net for weights, optimizer state, and shards stored elsewhere.
artifacts/
*.safetensors
*.pt
*.bin

# Experiment trackers and profiler traces (root-anchored: configs/runs/ is source)
/wandb/
/runs/
/tb_logs/
*.pt.trace.json
